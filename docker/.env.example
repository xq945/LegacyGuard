# 复制为 .env 后填写真实值
#   cp .env.example .env
#
# .env 已在 .gitignore 中，不会被提交。
# 所有值都不应该出现在代码、文档或截图中。

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_NAME=legacy_guard
DB_USER=legacyguard
DB_PASSWORD=change-me-db-password
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- RabbitMQ ----------
RABBITMQ_USER=legacyguard
RABBITMQ_PASSWORD=change-me-rabbit-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- 后端 ----------
SERVER_PORT=8080

# ---------- 前端 ----------
# 前端容器映射到宿主机的端口（容器内始终是 80）
FRONTEND_PORT=8081

# JWT 签名密钥，Base64 编码，解码后至少 32 字节。
# 生成方式：openssl rand -base64 32
# 必填，留空会导致后端启动失败（这是刻意的：宁可启动不了，也不要用弱密钥跑起来）
LG_JWT_SECRET=

# 允许跨域的前端地址，多个用逗号分隔。
#
# 5173 是 Vite 开发服务器端口（本地开发方式）；
# 8081 是容器化部署时前端映射到宿主机的端口（FRONTEND_PORT 的默认值）。
# 两者都列上，切换部署方式时不需要再改。
#
# 注意：经由前端容器的 nginx 反代时，请求是同源的，nginx 会剥离 Origin 头，
# 这里的配置不会参与判定；它主要服务于"浏览器直连后端端口"的调试场景。
LG_CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# 资产加密主密钥（KEK），格式 "版本=Base64"，解码后必须 32 字节。
# 生成：openssl rand -base64 32
#
# 下面这个值是开发环境的固定密钥，与 sql/demo-data.sql 里的演示资产密文匹配 ——
# 换成别的值，那三条演示资产就会解不开。生产环境必须重新生成。
# 丢失该密钥意味着所有已加密资产永久无法恢复，这是设计如此，没有后门。
LG_KEK_KEYS=1=cg3EyAxT7hS4hvP9Mitb02tWY+db//xLeGG90qoDNpA=
LG_KEK_CURRENT_VERSION=1
